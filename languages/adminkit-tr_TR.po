#: includes/Modules/DbMaintenance.php
msgid "Database maintenance"
msgstr "Veritabanı bakımı"

#: includes/Modules/DbMaintenance.php
msgid "Deletes old WordPress core leftovers: expired temporary data, old revisions, automatic drafts, trashed posts, spam comments and orphan meta rows. Preview first; deleting cannot be undone."
msgstr "Eski WordPress çekirdek artıklarını siler: süresi dolmuş geçici veri, eski revizyonlar, otomatik taslaklar, çöp kutusundaki yazılar, spam yorumlar ve yetim meta satırları. Önce önizleyin; silme geri alınamaz."

#: includes/Modules/DbMaintenance.php
msgid "Use database maintenance"
msgstr "Veritabanı bakımını kullan"

#: includes/Modules/DbMaintenance.php
msgid "Turn it on and press Save to open the cleanup tools."
msgstr "Açın ve Kaydet'e basın; temizlik araçları görünür."

#: includes/Modules/DbMaintenance.php
msgid "Revisions to keep per post"
msgstr "Yazı başına tutulacak revizyon"

#: includes/Modules/DbMaintenance.php
msgid "per post"
msgstr "yazı başına"

#: includes/Modules/DbMaintenance.php
msgid "Only older revisions beyond this number are deleted. The published post itself is never touched."
msgstr "Yalnız bu sayının ötesindeki eski revizyonlar silinir. Yayınlanmış yazının kendisine dokunulmaz."

#: includes/Modules/DbMaintenance.php
msgid "Cleanup tools"
msgstr "Temizlik araçları"

#: includes/Modules/DbMaintenance.php
msgid "Select at least one cleanup type."
msgstr "En az bir temizlik türü seçin."

#: includes/Modules/DbMaintenance.php
msgid "Counting…"
msgstr "Sayılıyor…"

#: includes/Modules/DbMaintenance.php
msgid "%1$d row(s) will be deleted (~%2$s)."
msgstr "%1$d satır silinecek (~%2$s)."

#: includes/Modules/DbMaintenance.php
msgid "Nothing matches the selected types. Nothing will be deleted."
msgstr "Seçilen türlerde eşleşen satır yok. Hiçbir şey silinmeyecek."

#: includes/Modules/DbMaintenance.php
msgid "Delete database rows?"
msgstr "Veritabanı satırları silinsin mi?"

#: includes/Modules/DbMaintenance.php
msgid "This cannot be undone. Take a database backup first."
msgstr "Bu işlem geri alınamaz. Önce veritabanı yedeği alın."

#: includes/Modules/DbMaintenance.php
msgid "Deleting…"
msgstr "Siliniyor…"

#: includes/Modules/DbMaintenance.php
msgid "%1$d of ~%2$d deleted (%3$s)"
msgstr "~%2$d satırın %1$d kadarı silindi (%3$s)"

#: includes/Modules/DbMaintenance.php
msgid "Finished: %d row(s) deleted."
msgstr "Bitti: %d satır silindi."

#: includes/Modules/DbMaintenance.php
msgid "Another maintenance run is in progress. Try again in a moment."
msgstr "Başka bir bakım koşusu sürüyor. Biraz sonra tekrar deneyin."

#: includes/Modules/DbMaintenance.php
msgid "The request failed. Nothing else was deleted."
msgstr "İstek başarısız oldu. Başka hiçbir satır silinmedi."

#: includes/Modules/DbMaintenance.php
msgid "Some rows could not be deleted; they may have changed meanwhile."
msgstr "Bazı satırlar silinemedi; bu sırada değişmiş olabilirler."

#: includes/Modules/DbMaintenance.php
msgid "Turn the module on and press Save to use the cleanup tools."
msgstr "Temizlik araçlarını kullanmak için modülü açın ve Kaydet'e basın."

#: includes/Modules/DbMaintenance.php
msgid "There is no undo. Deleted rows are gone for good. Take a full database backup before you run this; this tool does not create or download backups."
msgstr "Geri alma yoktur. Silinen satırlar geri gelmez. Bu aracı çalıştırmadan önce tam veritabanı yedeği alın; bu araç yedek oluşturmaz ve indirmez."

#: includes/Modules/DbMaintenance.php
msgid "The numbers below are live and read-only. Nothing is deleted until you preview the selection and confirm."
msgstr "Aşağıdaki sayılar canlıdır ve salt okunur. Siz önizleyip onaylamadan hiçbir şey silinmez."

#: includes/Modules/DbMaintenance.php
msgid "Cleanup types"
msgstr "Temizlik türleri"

#: includes/Modules/DbMaintenance.php
msgid "Type"
msgstr "Tür"

#: includes/Modules/DbMaintenance.php
msgid "Records"
msgstr "Kayıt"

#: includes/Modules/DbMaintenance.php
msgid "Size"
msgstr "Boyut"

#: includes/Modules/DbMaintenance.php
msgid "Preview selected"
msgstr "Seçilenleri önizle"

#: includes/Modules/DbMaintenance.php
msgid "Delete selected…"
msgstr "Seçilenleri sil…"

#: includes/Modules/DbMaintenance.php
msgid "Unknown cleanup type."
msgstr "Bilinmeyen temizlik türü."

#: includes/Modules/DbMaintenance.php
msgid "Type the confirmation word to delete. Nothing was deleted."
msgstr "Silmek için onay sözcüğünü yazın. Hiçbir şey silinmedi."

#: includes/Modules/DbMaintenance.php
msgid "%1$d row(s) deleted (%2$s)."
msgstr "%1$d satır silindi (%2$s)."

#: includes/Modules/DbMaintenance.php
msgid "DELETE"
msgstr "SİL"

#: includes/Modules/DbMaintenance.php
msgid "Expired temporary data (transients)"
msgstr "Süresi dolmuş geçici veri (transient)"

#: includes/Modules/DbMaintenance.php
msgid "Old revisions"
msgstr "Eski revizyonlar"

#: includes/Modules/DbMaintenance.php
msgid "Automatic drafts"
msgstr "Otomatik taslaklar"

#: includes/Modules/DbMaintenance.php
msgid "Trashed posts and pages"
msgstr "Çöp kutusundaki yazılar ve sayfalar"

#: includes/Modules/DbMaintenance.php
msgid "Spam and trashed comments"
msgstr "Spam ve çöpteki yorumlar"

#: includes/Modules/DbMaintenance.php
msgid "Orphan meta rows"
msgstr "Yetim meta satırları"

#: includes/Modules/DbMaintenance.php
msgid "Only temporary entries whose expiry time has passed. Live temporary data is kept."
msgstr "Yalnız süresi geçmiş geçici kayıtlar. Canlı geçici veri korunur."

#: includes/Modules/DbMaintenance.php
msgid "Keeps the newest %d revisions of each post. The published post itself is never touched."
msgstr "Her yazının en yeni %d revizyonu tutulur. Yayınlanmış yazının kendisine dokunulmaz."

#: includes/Modules/DbMaintenance.php
msgid "Automatic drafts older than 7 days (the same rule WordPress uses on its daily cleanup)."
msgstr "7 günden eski otomatik taslaklar (WordPress'in günlük temizlikte kullandığı kuralın aynısı)."

#: includes/Modules/DbMaintenance.php
msgid "Posts and pages that have been in the trash for more than 30 days."
msgstr "30 günden uzun süredir çöp kutusunda olan yazılar ve sayfalar."

#: includes/Modules/DbMaintenance.php
msgid "Spam and trashed comments older than 30 days."
msgstr "30 günden eski spam ve çöpteki yorumlar."

#: includes/Modules/DbMaintenance.php
msgid "Meta rows whose post, comment or term no longer exists."
msgstr "Yazısı, yorumu veya terimi artık var olmayan meta satırları."


